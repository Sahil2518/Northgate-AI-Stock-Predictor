# ========================================================
# Northgate AI Stock Predictor - Environment Configuration
# ========================================================

# 1. Platform Settings
PROJECT_NAME="Northgate AI Stock Predictor"
VERSION="1.0.0"
DEBUG=True

# 2. Broker Gateway Selection (Options: LOCAL_PAPER, DHAN, ANGEL_ONE, ALPACA)
BROKER_TYPE=LOCAL_PAPER

# Set to 'true' only when you want to route REAL LIVE execution orders to the exchange with real money.
# When 'false', all orders are executed in authentic NSE Sandbox Simulation Mode.
LIVE_EXECUTION_ENABLED=false

# 3. Dhan HQ API Credentials (100% Free NSE/BSE API)
# Get from Dhan Mobile App -> Profile -> DhanHQ APIs -> Generate Access Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# 4. Angel One SmartAPI Credentials (100% Free Developer Portal)
# Get from https://smartapi.angelbroking.com -> Create App
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_KEY=

# 5. US Equities (Alpaca Markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
